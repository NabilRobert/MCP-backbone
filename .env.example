APP_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis_mcp
APP_TARGET_DATABASE_URL=postgresql+asyncpg://demo_ro:demo_ro@localhost:5432/demo_public_dataset
APP_QUERY_TIMEOUT_SECONDS=5
APP_EXPLAIN_TIMEOUT_SECONDS=2
APP_COST_THRESHOLD=100000
APP_DEMO_RATE_LIMIT=5

# Slice E (text-to-SQL benchmark) only -- not read by the server itself.
# Fill in your own key to actually run scripts/run_benchmark.py.
# ANTHROPIC_API_KEY is read automatically by PydanticAI's Anthropic
# provider; BENCHMARK_MODEL picks which model string to use.
ANTHROPIC_API_KEY=
BENCHMARK_MODEL=anthropic:claude-sonnet-4-5
