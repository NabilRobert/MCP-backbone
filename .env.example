# ============================================================================
# Settings for the MCP SERVER itself (the actual app that runs all the time).
# All of these are required for the server to start -- copy this file to
# ".env" and fill in real values, never commit the real ".env" file.
# ============================================================================

# Two SEPARATE database connections, easy to mix up:
#
# APP_DATABASE_URL is THIS PROJECT'S OWN database -- where it stores its
# own bookkeeping: workspaces, API keys, the audit log of every query
# anyone has run, etc. Nobody queries this through the AI tools; it's
# purely internal, like a filing cabinet for the app itself.
APP_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis_mcp

# APP_TARGET_DATABASE_URL is the OUTSIDE database that AI clients are
# actually allowed to explore and query (read-only) through this server's
# tools. In production this should point at a database using the
# restricted, read-only role created by scripts/provision_readonly_role.py
# -- never a superuser/admin connection.
APP_TARGET_DATABASE_URL=postgresql+asyncpg://demo_ro:demo_ro@localhost:5432/demo_public_dataset

# How many seconds a real query is allowed to run before it gets killed.
# Protects against someone (accidentally or not) asking for something
# that would take forever to compute.
APP_QUERY_TIMEOUT_SECONDS=5

# Same idea, but for the quick "how expensive would this be?" cost-check
# step that runs BEFORE the real query (see app/query/cost_check.py).
# Kept short because this check itself should always be fast.
APP_EXPLAIN_TIMEOUT_SECONDS=2

# If the cost-check step above estimates a query would be more
# "expensive" than this number, the query gets rejected before it ever
# touches the real database. Calibrated against real data (Pagila,
# ~52k-row rental table): the heaviest realistic analytical query we
# measured -- a 5-table join with a GROUP BY -- cost ~21,000, and
# every cross join that touches a table with more than a few thousand
# rows costs 57,000+ (genuinely catastrophic ones cost in the millions).
# 40,000 sits with ~2x margin above the former and comfortably below
# the latter. See JOURNEY.md for the full measurements and a real,
# known gap this doesn't close (a cross join confined to small
# dimension tables stays under this threshold too -- empirically
# proven harmless at this data scale, not just assumed).
APP_COST_THRESHOLD=40000

# How many queries a single workspace can run before being temporarily
# blocked (a basic anti-abuse / cost-control measure). Deliberately small
# for now -- see app/auth/rate_limit.py for the exact time window.
APP_DEMO_RATE_LIMIT=5

# Signs the web console's login cookie. If you leave this blank, a
# random one is generated every time the server starts -- fine for
# local use, but it means everyone gets logged out of the console on
# every restart. Set this to a long random string (e.g. generate one
# with `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
# if you want logins to survive a restart.
APP_CONSOLE_SESSION_SECRET=

# Marks the console's login cookie Secure (sent over HTTPS only). Set
# to true on any deployment served over HTTPS. Keep false for local
# development over plain http://, or the browser discards the cookie
# and you can never stay logged in.
APP_CONSOLE_COOKIE_HTTPS_ONLY=false

# The MCP server's own DNS-rebinding protection only allows the Host
# header to be 127.0.0.1/localhost unless told otherwise -- confirmed
# by actually deploying this: every external request to a real
# deployment got rejected with "421 Misdirected Request" until this
# named the real domain. Comma-separated hostnames this server is
# actually reachable at from outside (no port, no scheme), e.g.
# "mcp.example.com". Leave blank for local-only use.
APP_MCP_ALLOWED_HOSTS=


# ============================================================================
# Settings for scripts/run_benchmark.py ONLY (Slice E, the text-to-SQL
# accuracy test). The server itself never reads anything below this line
# -- these only matter if you're actually running the benchmark script,
# and they cost you real money per run (you're paying an AI provider for
# each question asked). There are TWO different ways to set this up;
# pick ONE of them, not both.
# ============================================================================

# --- OPTION A (the one this project actually uses): Sumopod ---
# Sumopod is an OpenAI-compatible AI gateway: one account/key gives
# access to several different underlying models through one shared web
# address, instead of signing up with each AI provider separately.
#   1. SUMOPOD_API_KEY -- the key from your Sumopod account.
#   2. SUMOPOD_BASE_URL -- Sumopod's API address. Check Sumopod's own
#      docs/dashboard for the exact value -- not something to guess.
#   3. AI_MODEL -- whichever model name Sumopod expects you to type
#      (e.g. "gpt-5-mini"). This is specific to Sumopod's own naming,
#      check their docs/dashboard for the exact spelling.
# If SUMOPOD_API_KEY is filled in, the script automatically uses this
# option -- see _build_model() in scripts/run_benchmark.py for exactly
# how that decision is made.
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=
AI_MODEL=gpt-5-mini

# --- OPTION B (fallback, only used if SUMOPOD_API_KEY above is empty):
# call Anthropic (Claude) directly ---
# Use this if you have your own normal Anthropic API key (from
# console.anthropic.com) instead of Sumopod. If you use this option,
# AI_MODEL above should instead be something like
# "anthropic:claude-sonnet-4-5" -- don't set both options at once.
ANTHROPIC_API_KEY=
