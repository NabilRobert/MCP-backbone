# /etc/systemd/system/mcp-backbone.service on the VPS.
# Install: sudo cp deploy/mcp-backbone.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl restart mcp-backbone
# Secrets: none here. The app reads .env from WorkingDirectory.
#
# Public traffic arrives at https://mcp.my.id (port 443) through the Caddy
# reverse proxy that also serves the unrelated Tamara site (see
# deploy/caddy-mcp.caddyfile), which forwards to uvicorn on 8443. With
# deploy/firewall.sh applied, 8443 accepts connections only from Caddy's
# Docker network. uvicorn terminates TLS itself on 8443. The cert comes from Let's Encrypt
# via a Cloudflare DNS-01 challenge. certbot renews it, and
# deploy/certbot-deploy-hook.sh copies it to /etc/mcp-backbone/tls/ (this
# service runs as ubuntu, which can't read /etc/letsencrypt/live) and
# restarts the service.
#
# --forwarded-allow-ips 172.18.0.0/16: trust X-Forwarded-For only from Caddy's
# Docker network, so login throttling sees each visitor's real IP behind the
# proxy, while a client connecting directly to 8443 can't fake one.
#
# --timeout-graceful-shutdown 5: without it, a restart hangs until systemd's
# 90s stop timeout, because uvicorn waits for open MCP streaming connections
# (e.g. a connected Claude Code) to close on their own.
[Unit]
Description=Database MCP server (FastAPI + uvicorn)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/MCP-backbone
ExecStart=/home/ubuntu/MCP-backbone/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8443 --ssl-certfile /etc/mcp-backbone/tls/fullchain.pem --ssl-keyfile /etc/mcp-backbone/tls/privkey.pem --proxy-headers --forwarded-allow-ips 172.18.0.0/16 --timeout-graceful-shutdown 5
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
